# ==========================================================================
# Trajectory — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ==========================================================================

# --- AI provider (Anthropic) --------------------------------------------
# If ANTHROPIC_API_KEY is empty, the backend runs in DETERMINISTIC FALLBACK
# mode: every AI service returns an honest, evidence-only placeholder result
# and the app still works end-to-end. No fake facts are ever invented.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- GitHub connector ----------------------------------------------------
# Optional. Without a token the connector still works against the public API
# but is limited to 60 requests/hour. With a token: 5000 requests/hour.
GITHUB_TOKEN=

# --- Database ------------------------------------------------------------
# Postgres (recommended, used by docker-compose):
#   postgresql+psycopg://trajectory:trajectory@localhost:5432/trajectory
# SQLite (zero-config local/dev/test fallback, used when unset):
#   sqlite+pysqlite:///./trajectory.db
DATABASE_URL=

# --- CORS ----------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Frontend ------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Uploads -------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=15

# --- Rate limiting -------------------------------------------------------
AI_RATE_LIMIT_PER_MINUTE=20

# --- Security ------------------------------------------------------------
# Used to sign/seed internal tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# --- Runtime -------------------------------------------------------------
# One of: development | production | test
ENVIRONMENT=development

# --- Uploads storage dir (outside any public static path) ----------------
UPLOAD_DIR=./uploads

# --- HTTP timeouts (seconds) --------------------------------------------
HTTP_TIMEOUT_SECONDS=30
AI_TIMEOUT_SECONDS=60
